{
  "type": "object",
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal",
          "category",
          "status",
          "evidence",
          "source",
          "detail"
        ],
        "properties": {
          "signal": {
            "type": "string",
            "description": "what the finding is about: a short canonical name, 2 to 5 words, reused verbatim for the same thing"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "description": "one of the surface categories, verbatim"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "weak",
              "absent"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "URL, thread title, issue number, or quote"
          },
          "source": {
            "type": "string",
            "description": "where found: reddit, hn, github, blog, survey, competitor, docs"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string",
                "description": "engagement count, sentiment, specifics"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}