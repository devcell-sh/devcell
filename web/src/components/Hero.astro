---
interface Props {
  stableVersion: string;
  logoGrid: string[];
}
const { stableVersion, logoGrid } = Astro.props;
---

<div class="hero-wrap">
  <div class="hero">
    <div>
      <p class="hero-eyebrow">Open Source · Apache&nbsp;2.0 · <a href="https://github.com/devcell-sh/devcell" class="eyebrow-stars" style="white-space: nowrap;">★ GitHub</a>{stableVersion ? <Fragment> · <a href="https://github.com/devcell-sh/devcell/releases" class="eyebrow-stars">{stableVersion}</a></Fragment> : <Fragment> · <a href="https://github.com/devcell-sh/devcell/releases" class="eyebrow-stars">Releases</a></Fragment>} · <a href="https://github.com/devcell-sh/devcell/commits/main"><img src="https://img.shields.io/github/last-commit/devcell-sh/devcell?style=flat&label=last%20commit&color=C8FF00" alt="Last commit" class="star-badge" /></a></p>
      <h1>Claude Code,<br/>Without The<br/><span class="hl">Blast&nbsp;Radius.</span></h1>
      <p class="hero-desc">
        DevCell is a local-first sandbox for AI coding agents. Run Claude Code,
        Codex, OpenCode, or Gemini inside an isolated cell. Agents write, delete,
        and install freely. Your host is untouched.<br/><br/>
        No account. No API key with Max/Pro. <code>brew install</code> and go.
      </p>
      <blockquote class="hero-quote">
        <p>"Run this in a container, not your actual machine."</p>
        <cite>— Anthropic, Claude Code documentation</cite>
      </blockquote>
      <div class="hero-actions">
        <a href="https://github.com/devcell-sh/devcell" class="btn btn-primary">View on GitHub →</a>
        <a href="#quickstart" class="btn btn-secondary">Quickstart</a>
      </div>
    </div>

    <div class="terminal">
      <div class="terminal-bar">
        <span class="dot dot-r"></span>
        <span class="dot dot-y"></span>
        <span class="dot dot-g"></span>
      </div>
      <div><span class="t-path">~/myproject</span> <span class="t-dim">$</span> <span class="t-cmd"> devcell claude</span></div>
      <div class="t-dim">Opening cell myproject …</div>
      <div><span class="t-ok">✔</span><span class="t-dim"> mounted /home/alex/myproject</span></div>
      <div><span class="t-ok">✔</span><span class="t-dim"> ~/.ssh, ~/.aws: not mounted</span></div>
      <div class="t-hr">───────────────────────────────────────</div>
      <div class="t-splash">
        <div class="t-splash-logo">
          {logoGrid.map((row) =>
            [...row].map((cell) =>
              <span class={cell === '#' ? 'b' : ''} />
            )
          )}
        </div>
        <pre class="t-splash-info">  <span class="t-title">Claude Code</span>
<span class="t-dot">·</span> <span class="t-dim">Opus 4.6 · Claude Max</span>
  <span class="t-path">/myproject</span>
  <span class="t-path">&nbsp;</span></pre>
      </div>
      <div class="t-hr">───────────────────────────────────────</div>
      <div><span class="t-prompt">❯</span><span class="t-cmd"> implement login form</span></div>
      <div class="t-hr">───────────────────────────────────────</div>
      <div><span class="t-safe">⏵⏵ auto-approve · <span style="color:#fff">[</span><span style="color:#E85D26">*</span><span style="color:#AAAAAA">.</span><span style="color:#fff">]</span> Cell Active</span></div>
    </div>
  </div>
</div>
