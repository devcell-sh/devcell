---
// Marks a feature as experimental: a superscript "e" linking to the
// experimental-features page. `name` must be registered in
// web/src/data/experimental.json (generated by `task docs:experimental`
// from internal/experiments), so a stale marker fails the build.
import features from '../data/experimental.json';

interface Props { name: string }
const { name } = Astro.props;
const feature = features.find((f) => f.name === name);
if (!feature) {
  throw new Error(`Exp: "${name}" is not a registered experimental feature; see web/src/data/experimental.json`);
}
---
<sup class="exp"><a href="/docs/experimental" title={`Experimental (${feature.name}): ${feature.summary}`}>e</a></sup>

<style>
  .exp { font-size: 0.6em; margin-left: 0.15em; line-height: 0; }
  .exp a { color: #888; text-decoration: none; border-bottom: 1px dotted #888; }
  .exp a:hover { color: var(--accent, #e85d26); }
</style>
