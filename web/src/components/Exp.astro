---
// Marks a feature as experimental: a superscript "e" linking to the
// experimental-features page. Markup and name validation live in
// src/lib/exp.ts so set:html call sites (FAQ answers) render the same
// marker; an unregistered name fails the build.
import { expHtml } from '../lib/exp';

interface Props { name: string }
const { name } = Astro.props;
---
<Fragment set:html={expHtml(name)} />

<style is:global>
  .exp { font-size: 0.6em; margin-left: 0.15em; line-height: 0; }
  .exp a { color: #888; text-decoration: none; border-bottom: 1px dotted #888; }
  .exp a:hover { color: var(--accent, #e85d26); }
</style>
