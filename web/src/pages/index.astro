---
import Base from '../layouts/Base.astro';
import Exp from '../components/Exp.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Quickstart from '../components/Quickstart.astro';
import WhatsInside from '../components/WhatsInside.astro';
import LogoStrips from '../components/LogoStrips.astro';
import FAQ from '../components/FAQ.astro';

const stableVersion = process.env.STABLE_VERSION || '';

const stackColumns = ["base", "ultimate", "bbb", "electronics"];
const stackFeatures = [
  { name: "Dev essentials",  note: "zsh, git, tmux, ripgrep, jq, sqlite, mise, nix", in: ["base","ultimate","bbb","electronics"] },
  { name: "Go + Node + Python", note: "Go toolchain, Node.js 22, Python 3.13",       in: ["ultimate","bbb"] },
  { name: "Infra tools",     note: "OpenTofu, Packer, Helm",                          in: ["ultimate","bbb"] },
  { name: "Browser + sessions", note: "Chromium + Playwright, session handoff via devcell auth chrome", in: ["ultimate","bbb"], partial: ["ultimate","bbb"] },
  { name: "GUI desktop",     note: "VNC + RDP + IceWM + PulseAudio",                  in: ["ultimate","bbb","electronics"] },
  { name: "Security / RE",   note: "Ghidra-ready, Wine, QEMU, Swift, FreeRDP",        in: ["bbb"] },
  { name: "Electronics",     note: "KiCad, ngspice, ESPHome, PlatformIO, wokwi-cli",  in: ["electronics"] },
  { name: "11 MCP servers with backing tools",  note: "OpenTofu, KiCad, Inkscape, Yahoo Finance, EdgarTools, FRED, Google Maps, Linear, Notion", in: ["ultimate","bbb","electronics"] },
];

const logoGrid = [
  "___#___",
  "#__#__#",
  "_#_#_#_",
  "__###__",
  "_#_#_#_",
  "#__#__#",
  "___#___",
];

const compareRows = [
  { feature: "Host isolation",             devcell: "container, VM",       dockerSbx: "microVM",            daytona: "container",   microsandbox: "libkrun",  rawDocker: "manual" },
  { feature: "Account / login required",   devcell: "no",                  dockerSbx: "yes",                daytona: "yes",       microsandbox: "no",       rawDocker: "no" },
  { feature: "Claude Max/Pro (no API key)",devcell: "yes",                 dockerSbx: "documented, broken", daytona: "no",        microsandbox: "no",       rawDocker: "manual" },
  { feature: "CLAUDE.md + hooks preserved",devcell: "yes",                 dockerSbx: "no",                 daytona: "no",        microsandbox: "no",       rawDocker: "manual" },
  { feature: "MCP servers + backing tools",devcell: "yes, auto-config",    dockerSbx: "catalog (manual)",   daytona: "no",        microsandbox: "own MCP",  rawDocker: "manual" },
  { feature: "macOS + Windows VMs",        exp: "engine-windows", devcell: "yes",                 dockerSbx: "no",                 daytona: "no",        microsandbox: "no",       rawDocker: "no" },
  { feature: "Egress lockdown",            devcell: "yes",                 dockerSbx: "yes",                daytona: "yes",       microsandbox: "yes",      rawDocker: "manual" },
  { feature: "Local-first",                devcell: "yes",                 dockerSbx: "yes",                daytona: "cloud only", microsandbox: "yes",     rawDocker: "yes" },
  { feature: "Credential brokering",       devcell: "not yet",             dockerSbx: "yes (proxy)",        daytona: "yes (API)", microsandbox: "yes",      rawDocker: "manual" },
  { feature: "Snapshot / restore",         devcell: "not yet",             dockerSbx: "not yet",            daytona: "yes",       microsandbox: "yes",      rawDocker: "no" },
];

const faqItems = [
  { q: "Do I need an API key or Claude subscription?",
    a: "Bring your own license or model. Claude Max, Pro, and API keys all work — DevCell starts the same client you already use, just inside a container. Same goes for Codex, OpenCode, and Gemini." },
  { q: "Why not just write my own Dockerfile?",
    a: "You can — the afternoon is the demo; the maintenance is the product. A hand-rolled container needs MCP wiring, backing apps, a display server, secrets handling, UID mapping, and per-agent flags — and needs them again after every client update. Everything DevCell ships is defined in the open devcell-sh/home modules: read them, fork them, or reuse them standalone if you'd rather keep your own setup." },
  { q: "How is DevCell different from Docker Sandboxes?",
    a: "Docker Sandboxes use microVMs for stronger isolation and integrate with the Docker ecosystem. DevCell is local-first with no account required, preserves your CLAUDE.md and hooks, ships MCP servers with their backing tools pre-installed, and supports macOS and Windows VMs. Docker Sandboxes require a Docker account and drop your Claude config." },
  { q: "Can the agent install packages inside the container?",
    a: "Yes. The agent can run apt, npm install, pip install, nix — whatever the project needs. Network access is unrestricted by default. <code>devcell claude --solitary</code> locks down egress to allow-listed domains only. Port forwarding and extra volume mounts are configurable in devcell.toml." },
  { q: "Does my existing Claude Code config carry over?",
    a: "Your project-level config (CLAUDE.md, .claude/) is mounted with your project. Host ~/.claude/skills is mounted read-write, the rest of ~/.claude is read-only. Your host-machine config stays safe." },
  { q: "How big are the images? Can I skip Docker?",
    a: "Base is ~1.3 GB and builds in under 2 minutes; ultimate is ~20 GB. First run builds the default stack. No Docker? --os macos provisions the same cell as a VM (tart, Apple Silicon) — same toolchain, same commands." },
];

---

<style is:global>
    /* HERO */
    .hero-wrap { border-bottom: var(--border); }

    .hero {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem 3rem;
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: 3rem;
      align-items: start;
    }

    @media (max-width: 768px) {
      .hero { grid-template-columns: 1fr; padding: 2.5rem 1.25rem; gap: 2.5rem; }
    }

    @media (max-width: 480px) {
      .hero { padding: 2rem 1rem; }
      h1 { font-size: 1.75rem; letter-spacing: -1px; }
      .hero-desc { font-size: 0.8rem; max-width: 100%; }
      .hero-eyebrow { font-size: 0.6rem; letter-spacing: 1px; flex-wrap: wrap; }
      .terminal { font-size: 0.72rem; overflow: hidden; }
      .hero-actions { flex-direction: column; }
      .hero-actions .btn { text-align: center; }
      .hero-quote { max-width: 100%; }
      .hero-quote p { font-size: 0.72rem; }
      .hero-quote cite { font-size: 0.65rem; }
      section { padding: 2rem 1rem; }
    }

    .hero-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 1.5rem;
      height: 2px;
      background: #888;
    }

    h1 {
      font-size: clamp(2.8rem, 6vw, 5rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -2px;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    h1 .hl {
      background: var(--accent);
      display: inline-block;
      padding: 0.05em 0.15em;
      line-height: 0.9;
    }

    .hero-desc {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      line-height: 1.75;
      color: #444;
      margin-bottom: 2rem;
      max-width: 460px;
    }

    .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.75rem; }

    .hero-quote {
      border-left: 3px solid var(--black);
      padding: 0.75rem 1rem;
      background: var(--bg-muted);
      max-width: 460px;
    }

    .hero-quote p {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      line-height: 1.6;
      color: #333;
      margin-bottom: 0.35rem;
    }

    .hero-quote cite {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: #888;
      font-style: normal;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* TERMINAL */
    .terminal {
      background: #0D0D0D;
      font-family: var(--font-mono);
      font-size: 1rem;
      padding: 1.25rem 1.5rem;
      border: var(--border);
      box-shadow: var(--shadow-lg);
      line-height: 1.9;
      position: sticky;
      top: 5rem;
    }

    .terminal-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #222;
    }

    .dot { width: 11px; height: 11px; border-radius: 50%; }
    .dot-r { background: #FF5F57; }
    .dot-y { background: #FFBD2E; }
    .dot-g { background: #28CA41; }

    .t-path   { color: #5F8AFF; }
    .t-branch { color: #C678DD; }
    .t-cmd    { color: #888; }
    .t-ok     { color: #98C379; }
    .t-dim    { color: #555; }
    .t-hr     { color: #333; line-height: 1.2; }
    .t-dot    { color: #AAAAAA; }
    .t-title  { color: #E5E5E5; font-weight: 700; }
    .t-ver    { color: #555; }
    .t-safe   { color: #98C379; }
    .t-safe .fa-solid { font-size: 0.85em; vertical-align: baseline; }
    .t-prompt { color: #fff; }
    .t-splash {
      display: flex;
      align-items: flex-start;
      margin: 0.1rem 0;
      font-family: var(--font-mono);
      font-size: inherit;
      letter-spacing: 0;
    }
    .t-splash-logo {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      grid-template-rows: repeat(7, 1fr);
      width: 8ch;
      height: 4.65em;
      margin-right: 1ch;
      align-self: center;
      flex-shrink: 0;
    }
    .t-splash-logo .b { background: #E85D26; }
    .t-splash-info {
      font-family: var(--font-mono);
      white-space: pre;
      line-height: 1.55;
      margin: 0;
      letter-spacing: 0;
    }

    /* AGENT LOGOS */
    .agent-logos {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .agent-logos-label {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      white-space: nowrap;
    }

    .agent-logo {
      position: relative;
      display: flex;
      align-items: center;
    }

    .agent-logo img {
      height: 28px;
      width: 28px;
      opacity: 0.55;
      transition: opacity 0.15s;
    }

    .agent-logo:hover img {
      opacity: 1;
    }

    .agent-logo::after {
      content: attr(data-title);
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--black);
      color: var(--white);
      font-family: var(--font-mono);
      font-size: 0.6rem;
      padding: 0.2rem 0.4rem;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s;
    }

    .agent-logo:hover::after { opacity: 1; }

    /* SECTION */
    section { max-width: 1200px; margin: 0 auto; padding: 3rem 2rem; }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 0.6rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .section-label::before {
      content: '';
      display: inline-block;
      width: 1rem;
      height: 2px;
      background: #888;
    }

    h2 {
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -1px;
      margin-bottom: 2.5rem;
      border-bottom: var(--border);
      padding-bottom: 0.75rem;
    }

    /* CARDS */
    .does-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: var(--border);
      box-shadow: var(--shadow-lg);
    }

    @media (max-width: 900px) { .does-grid { grid-template-columns: 1fr; } }

    .does-card {
      padding: 1.75rem;
      border-right: var(--border);
      border-bottom: var(--border);
      background: var(--white);
      transition: background 0.12s;
    }

    .does-card:nth-child(3n) { border-right: none; }
    .does-card:last-child { border-right: none; border-bottom: none; }
    .does-card:nth-child(3n+1):nth-last-child(-n+3) { border-bottom: none; }
    .does-card:nth-child(3n+2):nth-last-child(-n+2) { border-bottom: none; }
    .does-card:nth-child(3n):nth-last-child(-n+1)   { border-bottom: none; }
    .does-card:hover { background: var(--accent); }

    .does-card a, .step a {
      color: var(--black);
      font-weight: 900;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .does-card a:hover, .step a:hover { background: var(--accent); text-decoration: none; }

    .card-icon {
      width: 28px;
      height: 28px;
      margin-bottom: 0.6rem;
      color: var(--black);
      flex-shrink: 0;
    }

    .does-card:hover .card-icon { color: var(--black); }

    .does-card h3 {
      font-size: 0.85rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.6rem;
    }

    .does-card p {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: #444;
      line-height: 1.65;
    }

    /* INSIDE */
    .features-wrap {
      background: var(--bg-muted);
      border-top: var(--border);
      border-bottom: var(--border);
    }

    .stacks-grid {
      border: var(--border);
      margin-bottom: 1rem;
    }

    .stack-row {
      display: grid;
      grid-template-columns: 13rem 1fr;
      border-bottom: 1px solid #CCCCCC;
      align-items: baseline;
    }

    .stack-row:last-child { border-bottom: none; }

    .stack-cat {
      font-size: 0.72rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 0.8rem 1.1rem;
      border-right: 1px solid #CCCCCC;
    }

    .stack-tools {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: #444;
      padding: 0.8rem 1.1rem;
    }

    @media (max-width: 600px) {
      .stack-row { grid-template-columns: 1fr; }
      .stack-cat { border-right: none; border-bottom: 1px solid #CCCCCC; }
    }

    .stacks-more {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: #888;
    }

    .stacks-more a {
      color: var(--black);
      font-weight: 900;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* LOGO GRID */
    .logo-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 0;
      margin-bottom: 1rem;
    }

    .logo-grid img {
      height: 28px;
      width: auto;
      filter: grayscale(100%) opacity(0.5);
      transition: filter 0.2s;
    }

    .logo-grid img:hover {
      filter: grayscale(0%) opacity(1);
    }

    .logo-item {
      position: relative;
      display: flex;
      align-items: center;
    }

    .logo-item::after {
      content: attr(data-title);
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--black);
      color: var(--white);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      padding: 0.25rem 0.5rem;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s;
    }

    .logo-item:hover::after {
      opacity: 1;
    }

    /* EYEBROW STAR LINK */
    .eyebrow-stars {
      color: var(--black);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }
    .eyebrow-stars:hover { color: var(--black); text-decoration: underline; }

    .star-badge {
      vertical-align: middle;
      height: 18px;
      margin-left: 2px;
    }

    /* QUICKSTART */
    .qs-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      align-items: start;
    }

    @media (max-width: 768px) { .qs-grid { grid-template-columns: 1fr; } }

    .steps { list-style: none; }

    .step {
      display: flex;
      gap: 1.1rem;
      margin-bottom: 1.5rem;
      align-items: start;
    }

    .step-num {
      background: var(--accent);
      border: var(--border);
      box-shadow: 3px 3px 0 #111;
      width: 2.2rem;
      height: 2.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 0.88rem;
      font-family: var(--font-mono);
      flex-shrink: 0;
    }

    .step h4 {
      font-size: 0.82rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.3rem;
    }

    .step p {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: #555;
      line-height: 1.6;
    }

    /* CODE BLOCK */
    .code-block {
      background: #0D0D0D;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      padding: 1.4rem 1.5rem;
      border: var(--border);
      box-shadow: var(--shadow);
      line-height: 1.9;
      overflow-x: auto;
      margin-bottom: 1.25rem;
    }

    .code-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #222;
    }

    .code-block .line { display: block; }
    .code-block .gap { display: block; height: 0.35rem; }
    .code-block .cmt { color: #444; }
    .code-block .cmd { color: #E5E5E5; }
    .code-block .arg { color: var(--accent); }

    /* DEMO SVG */
    .demo-wrap {
      display: flex;
      justify-content: center;
      margin-top: 1.5rem;
    }
    .demo-svg {
      width: 100%;
      max-width: 720px;
      border: var(--border);
      box-shadow: var(--shadow);
      border-radius: 4px;
      display: block;
    }

    /* NOTE */
    .note {
      border: var(--border);
      background: var(--bg-muted);
      box-shadow: var(--shadow);
      padding: 1.1rem 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      line-height: 1.65;
      color: #444;
    }

    .note strong {
      font-family: var(--font-sans);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: block;
      margin-bottom: 0.35rem;
      color: var(--black);
    }

    /* PLAN GRID */
    .plan-grid {
      border: var(--border);
      box-shadow: var(--shadow);
      overflow-x: auto;
      margin-bottom: 1.5rem;
    }

    .plan-grid table {
      width: 100%;
      border-collapse: collapse;
      min-width: 680px;
    }

    .plan-grid th {
      font-size: 0.7rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 0.7rem 0.5rem;
      text-align: center;
      border-bottom: var(--border);
      border-right: 1px solid #CCC;
      background: var(--white);
    }

    .plan-grid th:first-child {
      text-align: left;
      padding-left: 1rem;
      width: 11rem;
    }

    .plan-grid th:last-child { border-right: none; }

    .plan-grid th.col-default {
      background: var(--accent);
    }

    .plan-grid td {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      padding: 0.5rem 0.5rem;
      text-align: center;
      border-bottom: 1px solid #CCC;
      border-right: 1px solid #CCC;
      color: #DDD;
    }

    .plan-grid td:first-child {
      text-align: left;
      padding-left: 1rem;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--black);
    }

    .plan-grid td:last-child { border-right: none; }
    .plan-grid tr:last-child td { border-bottom: none; }
    .plan-grid tbody tr:nth-child(even) td { background: var(--bg-muted); }
    .plan-grid tbody tr:nth-child(even) td.col-default { background: color-mix(in srgb, var(--accent) 18%, var(--bg-muted)); }
    .plan-grid tbody tr:hover td { background: color-mix(in srgb, var(--accent) 25%, white); }

    .plan-grid td.col-default {
      background: color-mix(in srgb, var(--accent) 12%, white);
    }

    .plan-grid .has {
      color: var(--black);
      font-weight: 700;
    }

    .plan-grid sup {
      color: #888;
      font-size: 0.6rem;
      font-weight: 400;
    }

    /* IMAGE STACKS TABLE */
    .tag-default {
      background: var(--accent);
      font-size: 0.6rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 0.1em 0.35em;
      margin-left: 0.5rem;
      border: 1px solid var(--black);
    }

    /* QUICKSTART WRAP */
    .qs-wrap {
      background: var(--bg-muted);
      border-top: var(--border);
      border-bottom: var(--border);
    }

    /* FAQ */
    .faq-list { list-style: none; border: var(--border); box-shadow: var(--shadow); }

    .faq-list details {
      border-bottom: 1px solid #CCC;
      background: var(--white);
    }

    .faq-list details:last-child { border-bottom: none; }

    .faq-list summary {
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.9rem 1.25rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .faq-list summary::-webkit-details-marker { display: none; }

    .faq-list summary::before {
      content: '+';
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 400;
      color: #888;
      flex-shrink: 0;
      width: 1rem;
      text-align: center;
    }

    .faq-list details[open] summary::before { content: '−'; }

    .faq-list .faq-answer {
      font-family: var(--font-mono);
      font-size: 0.78rem;
